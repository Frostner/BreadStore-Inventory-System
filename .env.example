# Copy this file to .env, then choose a strong password BEFORE the first run.
ADMIN_EMAIL=admin@breadstore.local
ADMIN_PASSWORD=ReplaceWithYourOwnStrongPassword123!
# An existing database keeps its original admin credentials; edit through the database/admin tooling.
# For production, use a long, random secret to sign sessions (optional for this app, as sessions use random database tokens).
# COOKIE_SECURE=true  # set to true behind HTTPS for deployment
# SEED_DEMO=true       # set false to start without demo products
# DB_PATH=./data/breadstore.db
